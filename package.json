{
  "name": "dubai-logistics-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Source-verified register of logistics and warehousing investments, construction milestones and openings in Dubai.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-data": "tsx scripts/sync-data.ts",
    "predev": "npm run sync-data",
    "dev": "vite",
    "prebuild": "npm run sync-data",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "validate": "tsx scripts/validate-data.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.16.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.13.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.17.0",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
