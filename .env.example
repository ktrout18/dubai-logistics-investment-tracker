# Ingestion pipeline settings (see docs/PIPELINE.md). Copy to .env for local use;
# .env is git-ignored. Never commit real keys. In GitHub Actions, set
# ANTHROPIC_API_KEY as a repository *secret*; GITHUB_TOKEN is provided by Actions.
# The CLI does not load .env by itself: export the variables in your shell
# (e.g. `set -a; . ./.env; set +a`) before `npm run ingest`.

# Required for a live run (extraction with Claude Opus 5.5, search with Claude Haiku 5.5).
# Leave empty for keyless dry runs: npm run ingest:dry -- --search none
ANTHROPIC_API_KEY=

# Optional: open GitHub issues for pending-review items (both needed; Actions sets them).
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo

# Optional overrides (defaults in pipeline/config.ts)
# PIPELINE_SEARCH_MODEL=claude-haiku-5-5
# PIPELINE_EXTRACT_MODEL=claude-opus-5-5
# PIPELINE_WEB_SEARCH_TOOL=web_search_20250305
# PIPELINE_SEARCH_PROVIDER=anthropic        # anthropic | brave | none
# BRAVE_API_KEY=                            # only with PIPELINE_SEARCH_PROVIDER=brave
# PIPELINE_MAX_SEARCHES=40
# PIPELINE_MAX_EXTRACTIONS=25
# PIPELINE_RECHECK=5
# PIPELINE_MAX_ARTICLES_PER_SOURCE=8
# PIPELINE_MIN_INTERVAL_MS=3000
# PIPELINE_USER_AGENT=

# Only inside a sandbox that reaches the internet through an HTTPS proxy
# (not needed on GitHub-hosted runners):
# NODE_USE_ENV_PROXY=1
# NODE_EXTRA_CA_CERTS=/path/to/proxy-ca-bundle.crt
